# Adres BEZ ukośnika na końcu. Lokalnie: http://localhost:3000
SITE_URL=http://localhost:3000

# Server-only. Zostaw puste, żeby obejrzeć katalog bez bazy.
SUPABASE_URL=https://ukdekwmcbdxbwdymbyib.supabase.co
# Secret key (sb_secret_...) lub legacy service_role. Nigdy NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Ten sam e-mail co użytkownik utworzony w Supabase Authentication.
ADMIN_EMAIL=

# Restricted key Stripe z uprawnieniami opisanymi w README. Nigdy NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Losowy sekret min. 32 znaki, np. wygenerowany menedżerem haseł.
ORDER_TOKEN_SECRET=
PAYMENTS_ENABLED=false

# Uzupełnij przed włączeniem sprzedaży.
SELLER_NAME=
SELLER_ADDRESS=
SELLER_TAX_ID=
SELLER_CONTACT_EMAIL=
# Ustaw true po zatwierdzeniu warunków sprzedaży i polityki prywatności.
SALES_TERMS_READY=false

# Cennik netto: publikacja jednorazowa 50 zł/do 30 dni, abonament 50 zł/mies., podstrona 200 zł.
# Ustaw 23 dla czynnego podatnika VAT albo 0 przy właściwym zwolnieniu.
# Pozostaw puste do potwierdzenia swojego statusu VAT.
BILLING_VAT_PERCENT=
# Dla VAT 23: ID aktywnej stawki Stripe, country PL, percentage 23, inclusive false.
STRIPE_PL_VAT_RATE_ID=
